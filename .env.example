# Supabase (公開可能)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase (サーバーのみ - クライアントに露出禁止)
SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude API (サーバーのみ)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLMモデル設定 (省略時は以下のデフォルト値を使用)
CLASSIFIER_MODEL=claude-haiku-4-5
SPECIALIST_MODEL=claude-haiku-4-5
ORCHESTRATOR_MODEL=claude-sonnet-4-6

# チャット設定
CONTEXT_MESSAGE_LIMIT=20
SPECIALIST_TIMEOUT_MS=8000
LOCAL_CACHE_TTL_SECS=30

# Google Analytics / Search Console (サーバーのみ)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GA_PROPERTY_ID=properties/123456789
GSC_SITE_URL=sc-domain:takatsu-connect.com

# WordPress REST API
WORDPRESS_API_BASE=https://takatsu-connect.com/wp-json

# サイトURL (OAuth redirect用)
NEXT_PUBLIC_SITE_URL=https://takatsu-connect-advisor.vercel.app
